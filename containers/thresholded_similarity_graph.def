Bootstrap: docker
From: python:3.12-slim

%labels
    Author Luca Galli
    Description Exact percentile-thresholded Wasserstein similarity weighted degrees
    PythonVersion 3.12
    NumPyVersion 2.1.3
    JoblibVersion 1.4.2
    SciPyVersion 1.14.1
    SignalHandling "Use a named instance or apptainer run --pid"

%files
    scripts/graph_building/thresholded_similarity_graph.py /opt/dbm/scripts/graph_building/thresholded_similarity_graph.py
    scripts/graph_building/wasserstein_distance_graph2.py /opt/dbm/scripts/graph_building/wasserstein_distance_graph2.py
    scripts/pipeline_integrity.py /opt/dbm/scripts/pipeline_integrity.py

%post
    python -m pip install --no-cache-dir \
        numpy==2.1.3 \
        joblib==1.4.2 \
        scipy==1.14.1

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export OPENBLAS_NUM_THREADS=1
    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export NUMEXPR_NUM_THREADS=1

%runscript
    # `exec` makes Python the direct payload. With a named instance (or
    # `apptainer run --pid`), Apptainer's init shim terminates its workers too.
    exec python /opt/dbm/scripts/graph_building/thresholded_similarity_graph.py "$@"

%help
    Run this image with `apptainer instance run` or `apptainer run --pid` so
    every Joblib worker is isolated and terminated with its container.

%test
    set -eu
    export PYTHONPYCACHEPREFIX=/tmp/dbm-pycache
    python -c "import joblib, numpy, scipy; assert numpy.__version__ == '2.1.3'; assert joblib.__version__ == '1.4.2'; assert scipy.__version__ == '1.14.1'"
    python -m py_compile \
        /opt/dbm/scripts/pipeline_integrity.py \
        /opt/dbm/scripts/graph_building/wasserstein_distance_graph2.py \
        /opt/dbm/scripts/graph_building/thresholded_similarity_graph.py
    python /opt/dbm/scripts/graph_building/thresholded_similarity_graph.py --help >/dev/null
